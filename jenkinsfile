pipeline {
    agent any
    environment {
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '726695008545' 
        IMAGE_NAME     = 'mydockerimages'
        ECR_REPO       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker image ${ECR_REPO}:${BUILD_NUMBER}..."
                    sh "docker build -t ${ECR_REPO}:${BUILD_NUMBER} -t ${ECR_REPO}:latest ."
                }
            }
        }

        // NEW STAGE — inserted here, between Build and Push
        stage('Test Image') {
            steps {
                script {
                    echo "Running container to verify it starts and serves correctly..."
                    sh "docker run -d --name test-container-${BUILD_NUMBER} -p 8081:80 ${ECR_REPO}:${BUILD_NUMBER}"
                    sh "sleep 3"
                    sh "curl -f http://localhost:8081 || (docker logs test-container-${BUILD_NUMBER} && exit 1)"
                    sh "docker stop test-container-${BUILD_NUMBER} && docker rm test-container-${BUILD_NUMBER}"
                }
            }
        }

        stage('ECR Login & Push') {
            steps {
                script {
                    echo "Logging into AWS ECR in region ${AWS_REGION} using IAM Role..."
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    
                    echo "Pushing Docker image to ECR..."
                    sh "docker push ${ECR_REPO}:${BUILD_NUMBER}"
                    sh "docker push ${ECR_REPO}:latest"
                }
            }
        }
    }
    post {
        always {
            echo "Cleaning up local images..."
            sh "docker rmi -f ${ECR_REPO}:${BUILD_NUMBER} ${ECR_REPO}:latest || true"
            sh "docker rm -f test-container-${BUILD_NUMBER} || true"
        }
        success {
            echo "Pipeline executed successfully!"
        }
        failure {
            echo "Pipeline execution failed. Please check build logs."
        }
    }
}
